<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS static host for Flutter web (app.deltanium.com).

  Do NOT require the URL Rewrite module here — a missing <rewrite> section
  causes HTTP 500 for every request on IIS. Flutter defaults to hash routes
  (#/), so SPA fallback is optional.

  After installing IIS URL Rewrite, you may add a rule that rewrites
  non-file paths to /index.html for path-URL strategy.
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- Only register .wasm; .json is usually already defined at server level
           and a duplicate mimeMap yields 500.19. -->
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <!-- Cache-Control: no-cache on every file. Flutter's main.dart.js, index.html and
           flutter_bootstrap.js keep the same names across builds, so without this a browser
           keeps running the previous build after a deploy. no-cache still lets the browser cache;
           it just revalidates with the ETag first (a cheap 304 when nothing changed). -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
